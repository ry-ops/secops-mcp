# Wazuh manager API (VM104, 10.88.140.169) -- agents, rules, management
WAZUH_API_URL=https://10.88.140.169:55000
WAZUH_API_USER=
WAZUH_API_PASSWORD=

# Wazuh indexer / OpenSearch (VM104, port 9200) -- alerts live here, not
# on the manager API above
WAZUH_INDEXER_URL=https://10.88.140.169:9200
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASSWORD=

# Sandfly API (VM104, 10.88.140.169) -- like Wazuh, auth is username/password
# exchanged for a JWT (POST /auth/login), not a static token. Free-tier
# license caps the instance at one user, so this is the same admin account
# used for the web UI, not a dedicated read-only user.
SANDFLY_API_URL=https://10.88.140.169:8443/v4
SANDFLY_API_USER=
SANDFLY_API_PASSWORD=

# Checkmk REST API (VM108, 10.88.140.133, site "monitoring")
CHECKMK_API_URL=http://10.88.140.133:8080/monitoring/check_mk/api/1.0
CHECKMK_API_USER=
CHECKMK_API_SECRET=

# Ansible
ANSIBLE_INVENTORY_PATH=./config/inventory.yaml

# Slack (optional)
SLACK_WEBHOOK_URL=
